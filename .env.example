NODE_ENV=development
APP_VERSION=0.1.0
ALLOWED_ORIGINS=http://localhost:3000
ALLOWED_ORIGIN_REGEX=^https://pitock-web-.*\.vercel\.app$
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# https://<ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=
# https://<ref>.supabase.co/auth/v1
SUPABASE_JWT_ISSUER=
# Stringa di connessione pooler di Supabase
DATABASE_URL=
# openssl rand -base64 32
KEY_ENCRYPTION_SECRET=
DEFAULT_PROVIDER=anthropic
# ID di un modello con input immagini e PDF, dalla documentazione del provider
DEFAULT_MODEL=
PLATFORM_API_KEY=
PLATFORM_MONTHLY_RECEIPT_LIMIT=100
MAX_UPLOAD_BYTES=10485760
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# 1 solo in locale con pnpm inngest:dev (nessuna verifica della firma); ignorata in produzione
INNGEST_DEV=0
CRON_SECRET=
# Solo per pnpm simulate:upload (utente di prova del progetto Supabase di sviluppo)
SIMULATE_API_URL=http://localhost:8787
SIMULATE_EMAIL=
SIMULATE_PASSWORD=
SUPABASE_ANON_KEY=
