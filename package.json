{
  "name": "pitock-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/dev.ts",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --dir tests/unit",
    "test:integration": "vitest run --dir tests/integration",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "openapi:export": "tsx scripts/export-openapi.ts && prettier --write openapi.json",
    "inngest:dev": "pnpm dlx inngest-cli@latest dev -u http://localhost:8787/api/inngest",
    "simulate:upload": "tsx --env-file-if-exists=.env scripts/simulate-upload.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.71",
    "@ai-sdk/openai": "^4.0.83",
    "@hono/node-server": "^2.1.3",
    "@hono/zod-openapi": "^1.6.3",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@supabase/supabase-js": "^2.117.2",
    "ai": "^7.0.127",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.12",
    "inngest": "^4.21.1",
    "jose": "^6.2.12",
    "pino": "^10.4.0",
    "postgres": "^3.4.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^10.0.1",
    "@seriousme/openapi-schema-validator": "^2.11.0",
    "@types/node": "^26.6.4",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@12.9.1"
}
